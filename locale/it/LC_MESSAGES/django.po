#: templates/invitations/email/email_invite_message.txt:3
#, python-format
msgid ""
"\n"
"\n"
"Hello,\n"
"\n"
"You (%(email)s) have been invited to join %(site_name)s\n"
"\n"
"If you'd like to join, please go to %(invite_url)s\n"
"\n"
msgstr ""
"\n"
"\n"
"Ciao,\n"
"\n"
"Sei stato invitato a unirti a %(site_name)s con l'indirizzo %(email)s\n"
"\n"
"Se desideri iscriverti, vai al seguente link: %(invite_url)s\n"
"\n"

