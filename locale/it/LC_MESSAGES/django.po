msgstr "Aggiungi un indirizzo email qui sotto. L'utente riceverà un'email con le istruzioni."

#: templates/invitations/forms/_invite.html:9
msgid "Email"
msgstr "Email"

#: templates/invitations/messages/invite_accepted.txt:3
